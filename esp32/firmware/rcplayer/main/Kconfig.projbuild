menu "RC player"

config RCPLAYER_DOCUMENTS
    string "Embedded documents (names, space-separated; empty: all)"
    default ""
    help
        Only these documents are built in, in this order (the first is shown at start).
        Names are looked up in documents/, documents/fit/ and documents/3d/. Empty: every
        document in documents/ and documents/fit/ (and documents/3d/ when 3D is on).

endmenu
