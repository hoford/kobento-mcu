# The round board's settings for firmware/rcplayer (loaded after the app's own defaults).
# Internal RAM is short once Wi-Fi is up: put every plain malloc/new in PSRAM (the engine
# makes thousands of small ones) and keep a pool back for Wi-Fi, DMA and drivers.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
