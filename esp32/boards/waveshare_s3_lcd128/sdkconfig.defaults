# Waveshare ESP32-S3-LCD-1.28 / ESP32-S3-Touch-LCD-1.28: ESP32-S3R2 (2 MB quad PSRAM in the
# package), 16 MB W25Q128 flash, 1.28" round 240x240 GC9A01A on SPI, CST816S touch on the
# touch variant, console on UART0 through a CH343P bridge. Loaded by every app before its
# own sdkconfig.defaults. See README.md here.

CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# ── Memory ──
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
# CONFIG_SPIRAM_IGNORE_NOTFOUND is not set
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# ── Console: UART0 (GPIO43/44, the CH343P) at 115200 ──
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# ── BLE host memory in PSRAM ──
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y

# ── No 3D: 2 MB of PSRAM ──
CONFIG_KOBENTOVG_3D=n
