# The Core2's settings for firmware/rcplayer (loaded after the app's own defaults).
CONFIG_RCPLAYER_DEVICE_NAME="core2"
# Internal RAM (~300 KB) is the classic ESP32's limit: Wi-Fi buffers and SPI DMA need it.
# Put every plain malloc/new in PSRAM (the engine makes thousands of small ones) and keep a
# pool back for Wi-Fi, DMA and drivers, which ask for internal memory explicitly.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
# Home Assistant's three demo thermostats, a page each in one document: swipe, or the A / B / C
# marks under the screen (Control.next / .back); − and + change the set point, which the player
# sends to Home Assistant (console: ha url / ha token). Home Assistant pushes the values
# (~/homeassistant-demo). Drop this line for the usual demo documents.
CONFIG_RCPLAYER_DOCUMENTS="ha_thermostat_pages"
