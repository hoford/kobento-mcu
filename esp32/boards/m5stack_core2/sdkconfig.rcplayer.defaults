# The Core2's settings for firmware/rcplayer (loaded after the app's own defaults).
# Internal RAM (~300 KB) is the classic ESP32's limit. Put every plain malloc/new in PSRAM
# (the engine makes thousands of small ones) and keep a pool back for DMA and drivers, which
# ask for internal memory explicitly.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
