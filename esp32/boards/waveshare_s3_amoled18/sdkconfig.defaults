# Waveshare ESP32-S3-Touch-AMOLED-1.8: ESP32-S3R8 (8 MB octal PSRAM in the package), 16 MB
# flash, 1.8" 368x448 AMOLED (SH8601 on v1, CO5300 on v2) on QSPI, FT3168 / CST816 touch,
# AXP2101 PMU, console on the chip's USB Serial/JTAG. Loaded by every app before its own
# sdkconfig.defaults. See README.md here.

CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# ── Memory ──
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# ── Console: the chip's own USB (no bridge) ──
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# ── BLE host memory in PSRAM ──
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y

# ── 3D on: software rasterizer for mesh/camera/texture ops (test) ──
CONFIG_KOBENTOVG_3D=y
