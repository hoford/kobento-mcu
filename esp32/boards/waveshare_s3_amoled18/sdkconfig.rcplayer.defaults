# The AMOLED board's settings for firmware/rcplayer (loaded after the app's own defaults).
CONFIG_RCPLAYER_DEVICE_NAME="amoled"
# The engine's many small allocations go to PSRAM, so Wi-Fi, BLE and DMA keep internal RAM.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
