# The PaperS3's settings for firmware/muse-gadget (loaded after the app's own defaults).
CONFIG_HOMEHUB_BLE_NAME_SUFFIX="-Paper"
# The power button belongs to the PMS150G, not the ESP32: taps call gadget_ext_press().
CONFIG_HOMEHUB_BUTTON=n
# The engine's many small allocations go to PSRAM, so Wi-Fi, BLE and TLS keep internal RAM.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
