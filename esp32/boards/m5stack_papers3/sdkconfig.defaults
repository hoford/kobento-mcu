# M5Stack PaperS3: ESP32-S3R8 (8 MB octal PSRAM in the package), 16 MB flash, 4.7" 960x540
# e-ink (ED047TC1) on an 8-bit parallel bus, GT911 touch, console on the chip's USB
# Serial/JTAG. Loaded by every app before its own sdkconfig.defaults. See README.md here.

CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# ── Memory ──
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# CONFIG_SPIRAM_IGNORE_NOTFOUND is not set
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# ── Console: USB Serial/JTAG (GPIO44, UART0's RX, is the power-off line) ──
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# ── BLE host memory in PSRAM ──
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y

# ── No 3D: an e-ink panel shows no animation ──
CONFIG_KOBENTOVG_3D=n
