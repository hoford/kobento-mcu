# The CrowPanel 5.79"'s settings for firmware/rcplayer (loaded after the app's own defaults).
# 8 MB of flash: the app and a smaller storage partition.
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_8mb.csv"
# As on the other ESP32-S3 boards: every plain malloc/new in PSRAM (the engine makes
# thousands of small ones), and a pool of internal RAM kept back for DMA and drivers.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
